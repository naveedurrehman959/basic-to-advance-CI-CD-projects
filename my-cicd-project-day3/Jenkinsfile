pipeline {
    agent any
    environment {
       IMAGE_NAME= 'docker.io/naveedurehman/jenkin-cicd-repo'
       TAG = "${env.BUILD_NUMBER}"
    }
    stages {

        stage('Check Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la my-cicd-project-day3'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('my-cicd-project-day3') {
                    sh 'python3 -m venv .venv'
                    sh '.venv/bin/python -m pip install -r requirements.txt'
                    sh '.venv/bin/pip install bandit pip-audit'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('my-cicd-project-day3') {
                  sh '.venv/bin/python -m pytest'
                }
            }
        }

        stage('SAST') {
             steps {
                 dir('my-cicd-project-day3') {
                    sh '.venv/bin/python -m bandit -r app.py -f json -o bandit-report.json'
                }
             }  
        }
                stage('SCA') {
            steps {
                dir('my-cicd-project-day3') {
                    sh '.venv/bin/python -m pip-audit -r requirements.txt -f json -o pip-audit-report.json'

                }
            }
        }
        stage('build image') {
            steps {
                dir('my-cicd-project-day3') {
                  sh 'docker build -t "$IMAGE_NAME:$TAG" -t "$IMAGE_NAME:latest" .'
                }
            }
        }
    
        stage('push image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-id', 
                  passwordVariable: 'DOCKER_PASSWORD', 
                  usernameVariable: 'DOCKERHUB_USERNAME')]) {
                  sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKERHUB_USERNAME" --password-stdin'
                  sh 'docker push "$IMAGE_NAME:$TAG"'
                  sh 'docker push "$IMAGE_NAME:latest"'
                }

            }
            
        }
        stage (deploy){
            steps{
                sh 'docker pull "$IMAGE_NAME:$TAG"'
                sh 'docker rm -f jenkin-cicd-repo || true'
                sh 'docker run -d --name jenkin-cicd-repo -p 5000:5000  "$IMAGE_NAME:$TAG"'
            }
        }

    }

    post {
        success {
            echo 'CI Pipeline completed successfully!'
        }

        failure {
            echo 'CI Pipeline failed!'
        }
    }
}
