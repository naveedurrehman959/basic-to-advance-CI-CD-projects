
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'docker.io/naveedurehman/jenkin-cicd-repo'
        TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Check Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la my-cicd-project-day3.1'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('my-cicd-project-day3.1') {
                    sh 'python3 -m venv .venv'
                    sh '.venv/bin/python -m pip install -r requirements.txt'
                    sh '.venv/bin/python -m pip install bandit pip-audit'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('my-cicd-project-day3.1') {
                    sh '.venv/bin/python -m pytest'
                }
            }
        }

        stage('SAST - Bandit') {
            steps {
                dir('my-cicd-project-day3.1') {
                    sh '''
                        .venv/bin/python -m bandit \
                          -r app.py \
                          -f json \
                          -o bandit-report.json
                    '''
                }
            }
        }

        stage('SCA - pip-audit') {
            steps {
                dir('my-cicd-project-day3.1') {
                    sh '''
                        .venv/bin/python -m pip_audit \
                          -r requirements.txt \
                          -f json \
                          -o pip-audit-report.json
                    '''
                }
            }
        }

        stage('Build Image') {
            steps {
                dir('my-cicd-project-day3.1') {
                    sh '''
                        docker build \
                          -t "$IMAGE_NAME:$TAG" \
                          -t "$IMAGE_NAME:latest" .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                dir('my-cicd-project-day3.1') {
                    sh '''
                        docker run --rm \
                          -v /var/run/docker.sock:/var/run/docker.sock \
                          -v "$PWD:/work" \
                          -v trivy-cache:/root/.cache/trivy \
                          aquasec/trivy:0.75.0 image \
                          --timeout 15m \
                          --db-repository ghcr.io/aquasecurity/trivy-db:2 \
                          --scanners vuln \
                          --severity HIGH,CRITICAL \
                          --exit-code 1 \
                          --format json \
                          --output /work/trivy-report.json \
                          "$IMAGE_NAME:$TAG"
                    '''
                }
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-id',
                        passwordVariable: 'DOCKER_PASSWORD',
                        usernameVariable: 'DOCKERHUB_USERNAME'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" |
                          docker login \
                          -u "$DOCKERHUB_USERNAME" \
                          --password-stdin

                        docker push "$IMAGE_NAME:$TAG"
                        docker push "$IMAGE_NAME:latest"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker pull "$IMAGE_NAME:$TAG"
                    docker rm -f jenkin-cicd-repo || true
                    docker run -d \
                      --name jenkin-cicd-repo \
                      -p 5000:5000 \
                      "$IMAGE_NAME:$TAG"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'my-cicd-project-day3.1/*-report.json',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs and security reports.'
        }
    }
}
